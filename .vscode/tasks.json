{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Renderizar Apresentação (Quarto)",
      "type": "shell",
      "command": "quarto render \"${file}\"",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Preview Apresentação (Quarto)",
      "type": "shell",
      "command": "Set-Location '${fileDirname}'; quarto preview '${fileBasename}'",
      "group": "none",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
